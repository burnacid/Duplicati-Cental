# Duplicati Central: settings for docker-compose.yml
#
# Use it in one of two ways:
#   1. Copy to `.env` next to docker-compose.yml, then:  docker compose up -d
#   2. Copy to `.env.docker`, then:                      docker compose --env-file .env.docker up -d
#
# Every setting is optional; the values shown are the defaults.
# Restart after a change:  docker compose up -d

# ------------------------------------------------------------------ image and port

# Image tag to run: "latest" or a fixed version such as 0.1.0 (recommended for production).
DUPLICATI_CENTRAL_VERSION=latest

# Host port for the web UI, the Duplicati reporting API and the remote-control websocket.
HTTP_PORT=8181

# ------------------------------------------------------------------ address

# The address users and Duplicati instances use to reach this server, including the port
# when it is not 80/443. Used in reporting URLs, remote-control links and for passkeys.
# Passkeys only work when this is an https:// address.
APP_URL=http://localhost:8181

# Timezone for dates in the UI and in notifications, e.g. Europe/Amsterdam.
APP_TIMEZONE=UTC

# Automatic HTTPS with Let's Encrypt (see option A in docker-compose.yml): set your domain
# here, set APP_URL to https://<domain> and publish ports 80 and 443 instead of HTTP_PORT.
# Leave at :8181 for plain HTTP (e.g. behind your own reverse proxy).
SERVER_NAME=:8181

# Behind your own reverse proxy (Traefik, nginx, Caddy, ...): its IP address(es),
# comma-separated, or * to trust any proxy. Needed so HTTPS and client IPs are detected.
TRUSTED_PROXIES=

# ------------------------------------------------------------------ first admin

# Creates the first account when the container starts and there are no users yet.
# Without this, the first person who opens /register becomes the admin, so set it when
# the server is reachable from the internet. Remove the password after the first start;
# it is ignored once users exist.
#
# Alternatively create the account by hand:
#   docker exec -it duplicati-central php artisan user:create
# Locked out (lost password or 2FA device)?
#   docker exec -it duplicati-central php artisan user:reset-password you@example.com --disable-2fa
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------ accounts and security

# The first account can always be created. Set to true to allow more people to sign up.
REGISTRATION_ENABLED=false

# Require every user to set up an authenticator app (TOTP) or a passkey.
REQUIRE_2FA=false

# ------------------------------------------------------------------ features

# Remote control of Duplicati instances (registration, run backup, repair, history import).
REMOTE_CONTROL_ENABLED=true

# How long backup results are kept, in days (0 = forever).
BACKUP_RETENTION_DAYS=365

# ------------------------------------------------------------------ email

# Used by email notification channels that do not have their own SMTP server.
# MAIL_MAILER=log only writes emails to the log; use smtp to really send them.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=duplicati-central@example.com
MAIL_FROM_NAME="Duplicati Central"

# ------------------------------------------------------------------ database

# Only for option B (MariaDB/MySQL) in docker-compose.yml. Choose a long random password.
# Without option B the built-in SQLite database in the storage volume is used.
# DB_PASSWORD=
